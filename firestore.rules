rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Candidate Profiles ──────────────────────────────────────────────────
    // /candidate_profiles/{userId}
    // Users can read and write only their own candidate profile
    match /candidate_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ─── User-Specific Data Tree ─────────────────────────────────────────────
    // /users/{userId}
    match /users/{userId} {
      // Allow users to read and update their user root document
      allow read, write: if isOwner(userId);

      // Interview Sessions & Scorecards: /users/{userId}/interview_sessions/{sessionId}
      match /interview_sessions/{sessionId} {
        allow read, write, delete: if isOwner(userId);
      }

      // MCQ / OA Practice Progress: /users/{userId}/mcq_progress/{docId}
      match /mcq_progress/{docId} {
        allow read, write: if isOwner(userId);
      }

      // User Preferences & Settings: /users/{userId}/settings/{docId}
      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─── Live Interview Meeting Rooms ───────────────────────────────────────
    match /meetingRooms/{roomId} {
      allow create, read, update: if isAuthenticated();

      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isOwner(participantId);
      }

      match /signals/{signalId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if isAuthenticated()
          && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
